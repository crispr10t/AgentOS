# =====================================================================
# AgentOS Configuration Template
# Copy this file to .env and adjust the values according to your environment.
# =====================================================================

# --- LLM Provider Settings ---
# Options: 'ollama' (recommended for offline college demos), 'gemini', or 'openai'
LLM_PROVIDER=ollama

# Local Ollama Configuration (100% offline, zero-cost)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Cloud LLM API Keys (optional fallback when connected to the internet)
GEMINI_API_KEY=
OPENAI_API_KEY=

# --- Micro-Supervisor Kernel & Scheduling ---
# Scheduling Policy: 'FCFS' (default), 'PRIORITY', or 'SJF'
DEFAULT_SCHEDULER_POLICY=FCFS

# Subprocess Watchdog Limits
SUBPROCESS_TIMEOUT_SECONDS=10
MAX_PROCESS_MEMORY_MB=512

# Security & Privilege Ring
# When true, Ring 0 actions (delete, arbitrary compile/run) prompt user confirmation
ENABLE_RING0_PROMPT=true

# --- Paths & Storage ---
# Sandboxed root directory where AgentOS file operations are permitted
SANDBOX_ROOT=./sandbox_workspace

# SQLite Audit Log and Journal Database Path
DATABASE_PATH=./data/agentos.db
